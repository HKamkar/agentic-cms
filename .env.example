# Copy to .env.local (gitignored). Hostnames, comma-separated, no scheme/port,
# allowed to load dev assets and HMR besides localhost, e.g. a dev VM public IP.
ALLOWED_DEV_ORIGINS=

# Where endpoint forms deliver (src/config/form-delivery.ts, docs/forms.md):
# a webhook URL that receives each submission as JSON, and the secret that
# signs it. Unset in development, submissions are printed to the server's log.
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=

# The Google tag (GA4's "G-…" measurement id) behind the visitor's consent
# (src/config/analytics.ts, docs/consent.md). Unset, the site ships no tag and
# no consent banner. Set it where the production build runs, not in
# .env.local: the dev server would load the tag too.
GOOGLE_TAG_ID=
