{
  "name": "content-engine-kit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "node scripts/content-lint.mjs && node scripts/content-docs.mjs --check && next build && node scripts/check-seo.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./scripts/lib/load-ts.mjs --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "content:check": "node scripts/content-check.mjs",
    "content:lint": "node scripts/content-lint.mjs",
    "content:status": "node scripts/content-status.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --ip 0.0.0.0 --port 8000",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/hast": "^3.0.5",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "image-size": "^2.0.2",
    "motion": "^13.2.0",
    "next": "16.3.5",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.131.1"
  },
  "packageManager": "pnpm@12.4.1"
}
