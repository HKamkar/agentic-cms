{
  "name": "agentic-cms",
  "version": "0.3.2",
  "description": "A simple CMS whose editor is an AI agent: content as files in a Next.js repo, validated at build time; the content, blog, SEO and form engines, the reveal library, and the CLI that lints, audits and screenshots a site built on them",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "default": "./dist/content/index.js"
    },
    "./blog": {
      "types": "./dist/blog/index.d.ts",
      "default": "./dist/blog/index.js"
    },
    "./seo": {
      "types": "./dist/seo/index.d.ts",
      "default": "./dist/seo/index.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "default": "./dist/forms/index.js"
    },
    "./ix": {
      "types": "./dist/ix/index.d.ts",
      "default": "./dist/ix/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./cx": {
      "types": "./dist/cx.d.ts",
      "default": "./dist/cx.js"
    },
    "./loader": "./scripts/lib/load-ts.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "agentic-cms": "./bin/agentic-cms.mjs"
  },
  "files": [
    "bin",
    "dist",
    "scripts",
    "src/lib/**/README.md",
    "!scripts/*.test.mjs"
  ],
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "node bin/agentic-cms.mjs lint && node bin/agentic-cms.mjs docs --check && next build && node bin/agentic-cms.mjs seo",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./scripts/lib/load-ts.mjs --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\" \"tools/**/*.test.mjs\"",
    "plugin:validate": "claude plugin validate ./plugin --strict && claude plugin validate . --strict",
    "test:pack": "node tools/pack-smoke.mjs",
    "content:check": "node bin/agentic-cms.mjs check",
    "content:lint": "node bin/agentic-cms.mjs lint",
    "content:status": "node bin/agentic-cms.mjs status",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --ip 0.0.0.0 --port 8000",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:pkg": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "content:docs": "node bin/agentic-cms.mjs docs",
    "kit": "node bin/agentic-cms.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "image-size": "^2.0.2",
    "next-mdx-remote": "^6.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "motion": "^13.2.0",
    "next": ">=16.3.0",
    "playwright-core": ">=1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.2"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "motion": "^13.2.0",
    "next": "16.3.5",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.131.1",
    "zod": "^4.6.2"
  },
  "packageManager": "pnpm@12.4.1"
}
