{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": "src/lib",
    "incremental": false,
    "rewriteRelativeImportExtensions": true,
    "plugins": []
  },
  "include": ["src/lib/**/*.ts", "src/lib/**/*.tsx"],
  "exclude": ["node_modules", "src/lib/**/*.test.ts", "src/lib/content/test-helpers.ts"]
}
